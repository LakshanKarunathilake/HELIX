# Copy to .env and fill in. Placeholders only - never commit real values.

# Folder that holds the FAISS index files, and the filename prefix of the index.
INDEX_HOST_DIR=/absolute/path/to/index-folder
INDEX_PREFIX=your_index_prefix
# Folder with the SAPBERT adapter.
ADAPTER_HOST_DIR=/absolute/path/to/adapter-folder

# Shared secret HELIX sends to your KB. Generate: openssl rand -hex 32
KB_AUTH_TOKEN=replace-with-a-long-random-token

# Cloudflare Tunnel token (only for --profile tunnel).
CF_TUNNEL_TOKEN=replace-with-your-tunnel-token

# Only for --profile graph.
NEO4J_PASSWORD=replace-with-a-password
