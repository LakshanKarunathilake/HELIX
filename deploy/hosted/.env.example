# Copy to .env and fill in. See README.md.

# Public hostname; its DNS A record must point at this server.
HELIX_DOMAIN=helix.example.com

# Basic-auth gate. Make the hash with:
#   docker run --rm caddy:2.8.4 caddy hash-password --plaintext '<pw>'
# Keep the single quotes: the hash contains $ characters, which Compose would
# otherwise treat as variables.
HELIX_BASIC_USER=helix
HELIX_BASIC_HASH='$2a$14$replace.with.the.output.of.caddy.hash-password'

# Comma-separated host:port of KB servers that may use plain http (leave empty if all use https).
HELIX_URL_ALLOWLIST=

# Used by the LLM re-ranker / abbreviation features.
ANTHROPIC_API_KEY=

# Where backup.sh writes nightly archives.
BACKUP_DIR=/var/backups/helix
