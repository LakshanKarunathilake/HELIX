# Copy to .env and fill in. See README.md.

# Public hostname; its DNS A record must point at this server.
HELIX_DOMAIN=helix.example.com

# Firebase web config for Google sign-in (see README.md, "Firebase and accounts").
# These three are PUBLIC web identifiers, not secrets: the browser receives them
# from GET /api/info. Copy them from Firebase console -> Project settings -> Your apps.
HELIX_FIREBASE_PROJECT_ID=your-project-id
HELIX_FIREBASE_API_KEY=your-web-api-key
HELIX_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com

# Comma-separated host:port of KB servers that may use plain http (leave empty if all use https).
HELIX_URL_ALLOWLIST=

# Used by the LLM re-ranker / abbreviation features.
ANTHROPIC_API_KEY=

# Where backup.sh writes nightly archives.
BACKUP_DIR=/var/backups/helix
