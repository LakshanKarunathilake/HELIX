# Copy to .env and fill in. See README.md.
# Compose expands "$" in these values, so use letters and digits in passwords and keep "$"
# out of the other values.

# Public hostname; its DNS A record must point at this server.
HELIX_DOMAIN=helix.example.com

# Firebase web config for Google sign-in (see README.md, "Firebase and accounts").
# These three are PUBLIC web identifiers, not secrets: the browser receives them
# from GET /api/info. Copy them from Firebase console -> Project settings -> Your apps.
HELIX_FIREBASE_PROJECT_ID=your-project-id
HELIX_FIREBASE_API_KEY=your-web-api-key
HELIX_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com

# Password of the demo graph (the neo4j container): required, 8 or more letters and digits,
# for example the output of: openssl rand -hex 24
# An empty line is not enough, also when adding it to an existing .env, and it is needed even
# on a server that does not run the demo (README.md, "Running without the demo").
# It sets the password when the graph is first created; changing it later is described
# in README.md, "Changing the graph password".
NEO4J_PASSWORD=

# Folder on this server holding the demo search index. Leave empty for
# deploy/hosted/demo-index; a relative path starts in deploy/hosted/. On Linux the index files
# built there belong to root: use sudo to remove or replace them by hand.
DEMO_INDEX_DIR=

# Comma-separated host:port of further KB servers that may use plain http (leave empty if
# all use https). The bundled kb:8765 and neo4j:7687 are always allowed.
HELIX_URL_ALLOWLIST=

# The data source notice shown on every page. Leave empty for the MeSH 2026 attribution
# in docker-compose.yml; a replacement must still meet NLM's terms for the demo data.
# On a server without the demo data, " " (one space, in quotes) shows no notice.
HELIX_NOTICE=

# Used by the LLM re-ranker / abbreviation features.
ANTHROPIC_API_KEY=

# Where backup.sh writes nightly archives.
BACKUP_DIR=/var/backups/helix
