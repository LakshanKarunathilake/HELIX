# Copy to .env and fill in. Used by docker-compose.yml.

# ── secrets ───────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
NEO4J_PASSWORD=please-change

# ── KB index + adapter (host paths — mounted read-only, NOT copied) ───────────
# INDEX_HOST_DIR is the directory that CONTAINS the FAISS index files
# (<prefix>.faiss, <prefix>_metadata.pkl, <prefix>_config.json).
# INDEX_PREFIX is that filename prefix.
INDEX_HOST_DIR=/absolute/path/to/indexes/bioASQ_index_20260510
INDEX_PREFIX=bioASQ_index
ADAPTER_HOST_DIR=/absolute/path/to/Adapters/UMLS/sapbert-mesh-adapter

# ── Neo4j runtime config mounted into the API container ───────────────────────
# The uri inside this file must be reachable from the container:
#   - Neo4j as a compose service → bolt://neo4j:7687
#   - Neo4j on the host          → bolt://host.docker.internal:7687
NEO4J_CONFIG=./neo4j.docker.yaml

# ── document context texts (optional; for the annotator's context panel) ──────
CONTEXT_HOST_DIR=/absolute/path/to/texts
